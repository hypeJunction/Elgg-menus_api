{
    "name": "hypejunction/menus_api",
    "version": "7.0.0",
    "type": "elgg-plugin",
    "description": "Extends Elgg's menu system with a programmatic API for combining, filtering, and rendering navigation menus across plugins",
    "keywords": [
        "elgg",
        "plugin",
        "menus"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "elgg/elgg": "~7.0.0",
        "composer/installers": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "elgg-plugin": {
            "id": "menus_api"
        }
    },
    "homepage": "https://github.com/hypeJunction/Elgg-menus_api"
}
